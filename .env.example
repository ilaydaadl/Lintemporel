# Copiez ce fichier en ".env.local" et remplissez les valeurs.
# Sur Vercel : Project > Settings > Environment Variables (mêmes noms).

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé SECRÈTE (sb_secret_... ou service_role) : ne jamais la préfixer par NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Stripe > Développeurs > Clés API (sk_test_... pour les essais, sk_live_... en vrai)
STRIPE_SECRET_KEY=
# Stripe > Développeurs > Webhooks > votre endpoint > Clé secrète de signature (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Mondial Relay > votre compte pro : code enseigne (ex. CC12ABCD). Vide = démonstration.
NEXT_PUBLIC_MONDIAL_RELAY_BRAND=

# Brevo (newsletter) : Paramètres > SMTP & API > Clés API
BREVO_API_KEY=
# Contacts > Listes : numéro de la liste newsletter (ex. 3)
BREVO_LIST_ID=
# Adresse d'expédition validée dans Brevo (Expéditeurs, domaines et IP dédiées)
BREVO_SENDER_EMAIL=
